#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Compute 2-point correlation function (tpCF / MCF) covariance measurements
using jackknife or subsampling on a periodic box.

Usage examples
--------------
# Jackknife
python cal_cov_source_xismu data.npy random.npy 2500.0 jk -n 8 -v

# Subsample with weights (4th column of data.npy) raised to a power
python cal_cov_source_xismu data.npy random.npy 2500.0 subsample -ww -weipow 1.5 -v
"""

import argparse
import os
import sys

import joblib
import numpy as np
from LSS_python.cov import run_jackknife_tpCF, run_subsample_tpCF


# ---------------------------------------------------------------------------
# Data loading (mirrors cal_2pCF_box_weight_ap.read_data)
# ---------------------------------------------------------------------------
def read_data(filename, weight_set_one=False, with_weight=False):
    """
    Read ordinary npy arrays (plain arrays only, no structured arrays) and
    convert them to the required number of columns.

    Parameters
    ----------
    filename : str
        Path to the npy file containing catalog data.
    weight_set_one : bool, optional
        If True, force the weight column (4th column) to 1.0, by default False.
    with_weight : bool, optional
        If True, the returned array has 4 columns (x, y, z, weight).
        If False, the returned array has 3 columns (x, y, z only).

    Returns
    -------
    numpy.ndarray
        Catalog array with shape (N, 3) or (N, 4) as required.
    """
    source = np.load(filename)
    if source.dtype.names is not None:
        raise ValueError(
            f"Structured arrays are not supported: {filename} has named fields "
            f"{source.dtype.names}. Please save the catalog as a plain array "
            "with columns (x, y, z[, weight])."
        )

    ncols = source.shape[1]
    target_cols = 4 if with_weight else 3

    # Fast path: input already has the required shape and no weight
    # modification is needed, return directly without allocating new memory
    if ncols == target_cols and not weight_set_one:
        return source

    # General path: convert to the required number of columns
    result_array = np.zeros(shape=(source.shape[0], target_cols), dtype=source.dtype)
    # Copy position columns (whatever is available, at most 3)
    npos = min(ncols, 3)
    result_array[:, :npos] = source[:, :npos]

    # Handle the weight column if requested
    if with_weight:
        if weight_set_one or ncols < 4:
            # Force weights to 1.0, or fill missing weights with 1.0
            result_array[:, 3] = 1.0
        else:
            # Keep original weights
            result_array[:, 3] = source[:, 3]

    return result_array


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
def main():
    parser = argparse.ArgumentParser(
        description="Compute tpCF / MCF covariance via jackknife or subsampling."
    )

    # --- Positional arguments ---
    parser.add_argument("data_filename", type=str,
                        help="Path to data .npy file")
    parser.add_argument("random_filename", type=str,
                        help="Path to random .npy file")
    parser.add_argument("boxsize", type=float,
                        help="Box size (total boxsize, not the sub-box) of the simulation in Mpc/h")
    parser.add_argument("ngrid", type=int,
                        help="Number of sub-box divisions per axis")
    parser.add_argument("cov_source_type", choices=["jk", "subsample"],
                        help="Covariance method: jk (jackknife) or subsample")

    # --- Optional arguments ---
    parser.add_argument("--sbin", type=int, default=150,
                        help="Number of s bins (default: 150)")
    parser.add_argument("--mubin", type=int, default=120,
                        help="Number of mu bins (default: 120)")
    parser.add_argument("--s_max", type=float, default=150.0,
                        help="Maximum s value in Mpc/h (default: 150.0)")
    parser.add_argument("--rr_filename", "-rr", type=str, default="RR_temp.pkl",
                        help="RR pkl file for caching (default: RR_temp.pkl)")
    parser.add_argument("--tpcf_filename", "-tpcf", type=str, default="tpCF_temp.pkl",
                        help="Output tpCF pkl file (default: tpCF_temp.pkl)")

    # --- Weight handling options ---
    parser.add_argument("--with_weight", "-ww", action="store_true",
                        help="Load weights from 4th column of catalog files")
    parser.add_argument("--weight_pow", "-weipow", type=float, default=1.0,
                        help="Raise data weights to this power, i.e. weight**weipow "
                             "(valid only with --with_weight)")

    parser.add_argument("--nthreads", "-n", type=int, default=32,
                        help="Number of threads (default: 32)")
    parser.add_argument("--force", "-f", action="store_true", default=False,
                        help="Force recomputation even if output file exists")
    parser.add_argument("--force_rr", "-frr", action="store_true", default=False,
                        help="Force RR recomputation")
    parser.add_argument("--verbose", "-v", action="store_true", default=False,
                        help="Print verbose output")

    if len(sys.argv) == 1:
        parser.print_help()
        sys.exit(0)

    args = parser.parse_args()

    # --- Derived parameters ---
    sedges = np.linspace(0.0, args.s_max, args.sbin + 1)
    rr_type_str = "JK" if args.cov_source_type == "jk" else "sub"

    # --- Weight configuration (mirrors cal_2pCF_box_weight_ap) ---
    with_weight = args.with_weight
    weight_pow = args.weight_pow

    # If weight is not used, ignore weight-related settings
    if not with_weight:
        weight_pow = 1.0

    # --- Print configuration ---
    if args.verbose:
        print("=" * 50, flush=True)
        print("tpCF / MCF covariance source calculation", flush=True)
        print("=" * 50, flush=True)
        print(f"  data:          {args.data_filename}", flush=True)
        print(f"  random:        {args.random_filename}", flush=True)
        print(f"  boxsize:       {args.boxsize}", flush=True)
        print(f"  cov method:    {args.cov_source_type} ({rr_type_str})", flush=True)
        print(f"  ngrid:         {args.ngrid}", flush=True)
        print(f"  sbin:          {args.sbin}", flush=True)
        print(f"  mubin:         {args.mubin}", flush=True)
        print(f"  s_max:         {args.s_max}", flush=True)
        print(f"  with_weight:   {with_weight}", flush=True)
        print(f"  weight_pow:    {weight_pow}", flush=True)
        print(f"  rr_filename:   {args.rr_filename}", flush=True)
        print(f"  tpcf_filename: {args.tpcf_filename}", flush=True)
        print(f"  nthreads:      {args.nthreads}", flush=True)
        print(f"  force:         {args.force}", flush=True)
        print(f"  force_rr:      {args.force_rr}", flush=True)
        print("=" * 50, flush=True)

    # --- Step 1: Load data ---
    print(f"[1/3] Loading data from {args.data_filename} ...", flush=True)
    data = read_data(args.data_filename, weight_set_one=False, with_weight=with_weight)
    if args.verbose:
        print(f"       data shape: {data.shape}, with_weight={with_weight}", flush=True)

    # Apply power to data weights: weight -> weight**weight_pow
    if weight_pow != 1.0:
        print(f"Applying weight power: weight**{weight_pow}", flush=True)
        data[:, 3] = data[:, 3] ** weight_pow

    # --- Step 2: Load random ---
    # For random catalog, if weight is not used, set weight to 1
    print(f"[2/3] Loading random from {args.random_filename} ...", flush=True)
    random = read_data(args.random_filename,
                       weight_set_one=not with_weight, with_weight=with_weight)
    if args.verbose:
        print(f"       random shape: {random.shape}", flush=True)

    # --- Step 3: Compute covariance ---
    result_filename = args.tpcf_filename

    if args.verbose:
        print(f"[3/3] Computing covariance ({args.cov_source_type}) ...", flush=True)
        print(f"       output: {result_filename}", flush=True)

    result_dir = os.path.dirname(result_filename)
    if result_dir and not os.path.exists(result_dir):
        os.makedirs(result_dir)
        if args.verbose:
            print(f"       created dir: {result_dir}", flush=True)

    if os.path.exists(result_filename) and not args.force:
        print(f"       output file already exists, skipping. Use -f to overwrite.", flush=True)
        return

    if args.cov_source_type == "subsample":
        result_dict = run_subsample_tpCF(
            data, random, sedges, args.mubin,
            with_weight=with_weight,
            boxsize=args.boxsize,
            ngrids=args.ngrid,
            rr_filename=args.rr_filename,
            force_rr=args.force_rr,
            nthreads=args.nthreads,
            verbose=args.verbose,
            full_output=False,
        )
    else:
        result_dict = run_jackknife_tpCF(
            data, random, sedges, args.mubin,
            with_weight=with_weight,
            boxsize=args.boxsize,
            ngrids=args.ngrid,
            rr_filename=args.rr_filename,
            force_rr=args.force_rr,
            nthreads=args.nthreads,
            verbose=args.verbose,
            full_output=False,
        )

    joblib.dump(result_dict, result_filename)
    print(f"       -> saved: {result_filename}", flush=True)
    print("Done.", flush=True)


if __name__ == "__main__":
    main()

