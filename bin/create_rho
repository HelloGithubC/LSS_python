#!/usr/bin/env python3
"""
Density mark calculator for simulation boxes.
This script adds a local number-density mark to particle catalogs using
LSS_python.MCF. The mark method is selected with --rho-method; currently only
the "n<k>" k-nearest-neighbour mode (e.g. n30 -> k=30) is supported, based on
LSS_python.MCF.create_rho. Future methods (e.g. "r<radius>" fixed-radius mode)
can be added to the dispatch below.

The input must be a plain .npy array with shape (N, >=3); the first three
columns are treated as positions. The output is the input data with the
density mark appended as a 4th column (N, 4).

Example
-------
    create_rho snapshot.npy 2000.0 snapshot_rho.npy -method n30 -n 40
"""

import argparse
import os
import re
import sys

import numpy as np

from LSS_python.MCF import create_rho

METHOD_PATTERN = re.compile(r"^n(\d+)$")


def parse_method(method):
    """
    Dispatch a --rho-method string to the corresponding density routine.

    Returns
    -------
    tuple
        (kind, value, error)
        kind : str, dispatch key ("n" for k-nearest-neighbour mode)
        value : int or float, the numeric payload (k for "n<k>")
        error : str or None, error message when the method is not supported
    """
    match = METHOD_PATTERN.match(method)
    if match:
        value = int(match.group(1))
        if value <= 0:
            return None, None, f"k must be positive in method '{method}'"
        return "n", value, None
    return None, None, (
        f"unsupported rho-method '{method}'. "
        "Supported methods: n<digits> (e.g. n30)."
    )


# ============================================================================
# Command-line argument parser
# ============================================================================
parser = argparse.ArgumentParser(
    prog="create_rho",
    usage="Add a density mark to particle data with LSS_python",
    description="Compute a local number-density mark and append it as a 4th column"
)

parser.add_argument("data_filename",
                    help="Path to .npy file with shape (N, >=3); first 3 columns are positions",
                    type=str)
parser.add_argument("BoxSize",
                    type=float,
                    help="Periodic box size of the simulation")
parser.add_argument("output_filename",
                    help="Output .npy filename (input data plus rho as 4th column)")

parser.add_argument("--rho-method", "-method",
                    type=str,
                    default="n30",
                    help="Density mark method, currently only 'n<digits>' (e.g. n30 means "
                         "k=30 nearest neighbours) (default: n30)")
parser.add_argument("--nthreads", "-n",
                    type=int,
                    default=os.cpu_count() or 1,
                    help="Number of threads (default: all available cores)")
parser.add_argument("--ignore-self", "-ignore_self",
                    action="store_true",
                    help="Exclude the query point itself from its neighbour list (default: False)")
parser.add_argument("--no-adaptive-h", "-no_adaptive_h",
                    action="store_true",
                    help="Disable adaptive smoothing length; requires -h_fixed (default: False)")
parser.add_argument("--h-fixed", "-h_fixed",
                    type=float,
                    default=None,
                    help="Fixed smoothing length h, used with --no-adaptive-h (default: None)")
parser.add_argument("--force", "-force", "-f",
                    action="store_true",
                    help="Overwrite the output file even if it exists")
parser.add_argument("--verbose", "-v",
                    action="store_true",
                    help="Enable verbose output")

if len(sys.argv) == 1:
    parser.print_help()
    sys.exit(0)

args = parser.parse_args()

data_filename = args.data_filename
boxsize = args.BoxSize
output_filename = args.output_filename
nthreads = args.nthreads

# ============================================================================
# Validate arguments
# ============================================================================
if boxsize <= 0:
    parser.error("BoxSize must be positive")
if nthreads <= 0:
    parser.error("nthreads must be positive")

method_kind, method_value, method_error = parse_method(args.rho_method)
if method_error is not None:
    parser.error(method_error)

use_adaptive_h = not args.no_adaptive_h
if not use_adaptive_h and args.h_fixed is None:
    parser.error("--no-adaptive-h requires --h-fixed")

if os.path.exists(output_filename) and not args.force:
    print(f"Output file {output_filename} already exists. Use -force to re-compute.")
    sys.exit(0)

# ============================================================================
# Load data
# ============================================================================
if not os.path.isfile(data_filename):
    print(f"ERROR: missing input file: {data_filename}", file=sys.stderr, flush=True)
    sys.exit(1)

if args.verbose:
    print(f"Loading {data_filename} ...", flush=True)
data = np.load(data_filename)
if data.ndim != 2 or data.shape[1] < 3:
    print(f"ERROR: expected shape (N, >=3), got {data.shape}: {data_filename}",
          file=sys.stderr, flush=True)
    sys.exit(1)

pos = data[:, :3]
if args.verbose:
    print(f"Number of particles is {pos.shape[0]:d}; BoxSize is {boxsize:.0f}.", flush=True)
    print(f"rho-method is {args.rho_method} (k={method_value}); "
          f"Use nthreads: {nthreads:d}.", flush=True)

# ============================================================================
# Compute the density mark (method dispatch)
# ============================================================================
if method_kind == "n":
    out = create_rho(
        pos,
        boxsize=boxsize,
        k=method_value,
        nthreads=nthreads,
        only_return_rho=False,
        ignore_self=args.ignore_self,
        use_adaptive_h=use_adaptive_h,
        h=args.h_fixed,
    )
    expected_cols = 4
else:
    print(f"ERROR: unhandled method kind '{method_kind}'", file=sys.stderr, flush=True)
    sys.exit(1)

if out.shape[0] != pos.shape[0] or out.shape[1] != expected_cols:
    print(f"ERROR: unexpected create_rho output shape {out.shape}, "
          f"expected ({pos.shape[0]:d}, {expected_cols:d})", file=sys.stderr, flush=True)
    sys.exit(1)

np.save(output_filename, out)
if args.verbose:
    print(f"Wrote {output_filename} with shape {out.shape}.", flush=True)
