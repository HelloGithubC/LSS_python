#!/usr/bin/env python3
"""
FFT power spectrum calculator for simulation boxes.
This script computes the power spectrum (P(k)) from particle data using FFT-based methods.
It first meshes the particle distribution onto a grid, then computes the power spectrum
from the Fourier-transformed density field.

Supports weighted particles and optional value fields. Can save intermediate mesh
data for re-use and supports both 1D and 2D power spectrum calculations.
"""

import numpy as np
from LSS_python.mesh import Mesh
from LSS_python.fftpower import FFTPower, FFTPower2D
import os, sys, warnings
import argparse

def read_data(filename, weight_key, value_key):
    """
    Load particle data from a .npy file.

    Supports both structured arrays (with named fields) and plain arrays.
    For structured arrays, positions are extracted from 'Pos' (or 'X', 'Y', 'Z'),
    and weight/value fields are looked up by field name.
    For plain arrays, weight_key and value_key act as boolean flags: when not None,
    they enable the corresponding column (4th for weight, 5th for value).

    When fields have different dtypes, the output is promoted to the highest
    precision and a warning is issued.

    Parameters
    ----------
    filename : str
        Path to the .npy file containing particle data
    weight_key : str or None
        For structured arrays: field name for weights.
        For plain arrays: if not None, enables 4th column as weight.
        None means no weights.
    value_key : str or None
        For structured arrays: field name for values.
        For plain arrays: if not None, enables the next column after weight as value.
        None means no values.

    Returns
    -------
    tuple
        (data_array, use_weight, use_value)
        - data_array : ndarray, shape (N, 3), (N, 4) or (N, 5)
        - use_weight : bool, whether weight column is present
        - use_value : bool, whether value column is present

    Raises
    ------
    ValueError
        If required fields/columns are missing or data format is invalid
    """
    source = np.load(filename)

    # === Structured array path (has named fields) ===
    if source.dtype.names is not None:
        # Identify position columns
        if "Pos" in source.dtype.names:
            pos = source["Pos"]
        elif ("X" in source.dtype.names and "Y" in source.dtype.names
              and "Z" in source.dtype.names):
            pos = np.stack([source["X"], source["Y"], source["Z"]], axis=1)
        else:
            raise ValueError(
                "Structured array must contain 'Pos' or ('X', 'Y', 'Z') fields"
            )

        # Validate requested fields exist
        if weight_key is not None and weight_key not in source.dtype.names:
            raise ValueError(
                f"weight_key '{weight_key}' not found in structured array fields"
            )
        if value_key is not None and value_key not in source.dtype.names:
            raise ValueError(
                f"value_key '{value_key}' not found in structured array fields"
            )

        use_weight = weight_key is not None
        use_value = value_key is not None

        # Determine output dtype; promote if mixed types
        dtypes = [pos.dtype]
        if use_weight:
            dtypes.append(source[weight_key].dtype)
        if use_value:
            dtypes.append(source[value_key].dtype)

        final_dtype = np.result_type(*dtypes)
        if final_dtype != pos.dtype:
            warnings.warn(
                f"Type mismatch: position dtype is {pos.dtype}, "
                f"but weight/value fields have "
                f"{', '.join(str(d) for d in dtypes[1:])}. "
                f"Output array promoted to {final_dtype}."
            )

        # Assemble output array
        ncols = 3 + (1 if use_weight else 0) + (1 if use_value else 0)
        out = np.empty((source.shape[0], ncols), dtype=final_dtype)
        out[:, :3] = pos
        col = 3
        if use_weight:
            out[:, col] = source[weight_key]
            col += 1
        if use_value:
            out[:, col] = source[value_key]

    # === Plain array path (no named fields) ===
    else:
        use_weight = weight_key is not None
        use_value = value_key is not None
        ncols = 3 + (1 if use_weight else 0) + (1 if use_value else 0)

        if source.shape[1] < ncols:
            raise ValueError(
                f"Plain array has {source.shape[1]} columns, "
                f"but {ncols} are needed (3 positions"
                + (" + 1 weight" if use_weight else "")
                + (" + 1 value" if use_value else "")
                + ")"
            )

        out = source[:, :ncols].copy()

    return out, use_weight, use_value
    
    
def split_filename(filename):
    """
    Split a filename into directory, base name, and extension.
    
    Parameters
    ----------
    filename : str
        Full path to the file
        
    Returns
    -------
    tuple
        (directory, basename, extension) with trailing slash added to directory if non-empty
    """
    file_dir, file_name = os.path.split(filename)
    if file_dir == "":
        pass
    else:
        file_dir += "/"
    file_name, file_ext = os.path.splitext(file_name)
    return file_dir, file_name, file_ext
        
    
# ============================================================================
# Command-line argument parser
# ============================================================================
parser = argparse.ArgumentParser(
    prog="cal_fftpower_box", 
    usage="Calculate FFT power spectrum with LSS_python for simulation boxes",
    description="Compute power spectrum from particle data using FFT-based methods"
)

# Required positional arguments
parser.add_argument("data_filename", 
                   help="Path to .npy file containing particle data", 
                   type=str)
parser.add_argument("BoxSize", 
                   type=float, 
                   help="Box size of the simulation. If <=0, calculated from data")
parser.add_argument("Nmesh", 
                   type=int, 
                   help="Number of mesh cells per dimension (grid resolution)")
parser.add_argument("nthreads", 
                   type=int, 
                   help="Number of threads for parallel computation")

# Data field options
parser.add_argument("--weight_key", "-wei", 
                   type=str, 
                   default=None, 
                   help="Key in data dict for particle weights (default: None)")
parser.add_argument("--value_key", "-val", 
                   type=str, 
                   default=None, 
                   help="Key in data dict for particle values (default: None)")
parser.add_argument("--not_norm", "-nnorm", 
                   action="store_true", 
                   help="Disable density normalization when meshing (default: False, i.e. to normalize)")

# Power spectrum binning parameters
parser.add_argument("-kmin", 
                   type=float, 
                   default=0.1, 
                   help="Minimum wavenumber k (default: 0.1)")
parser.add_argument("-kmax", 
                   type=float, 
                   default=1.0, 
                   help="Maximum wavenumber k (default: 1.0)")
parser.add_argument("-dk", 
                   type=float, 
                   default=None, 
                   help="Wavenumber bin width (default: None). Need to set when not using --use_FFTPower2D")
parser.add_argument("-Nmu", 
                   type=int, 
                   default=30, 
                   help="Number of mu bins for 2D power spectrum (default: 30)")
parser.add_argument("-mode", 
                   type=str, 
                   default="1d", 
                   choices=["1d", "2d"], 
                   help="Power spectrum mode: '1d' (angle-averaged) or '2d' (default: '1d')")

# Output file options
parser.add_argument("--fftpower_filename", "-fftpower", 
                   help="Output filename for power spectrum (default: auto-generated)", 
                   default=None)
parser.add_argument("--mesh_dir", "-mesh", 
                   help="Directory to save/load mesh data (default: auto-generated)", 
                   default=None)

# Execution mode flags
parser.add_argument("--use_FFTPower2D", "-FFTPower2D", 
                   action="store_true",
                   help="Use FFTPower2D rather than FFTPower (default: False)")
parser.add_argument("--only_run_mesh", "-only_mesh", 
                   action="store_true", 
                   help="Only compute the mesh, skip power spectrum calculation")
parser.add_argument("-force", "-f", 
                   action="store_true", 
                   help="Force re-computation of power spectrum even if output exists")
parser.add_argument("--force_mesh", "-fmesh", 
                   action="store_true", 
                   help="Force re-computation of mesh even if it exists")

# Verbosity
parser.add_argument("--verbose", "-v", 
                   action="store_true", 
                   help="Enable verbose output during computation")

# ============================================================================
# Parse command-line arguments
# ============================================================================
if len(sys.argv) == 1:
    parser.print_help()
    exit(0)

argv = parser.parse_args()

# Extract data filename components
data_filename = argv.data_filename
data_dir, data_name, data_ext = split_filename(data_filename)

# Simulation parameters
boxsize = argv.BoxSize
Nmesh = argv.Nmesh
nthreads = argv.nthreads

# Data field configuration
weight_key = argv.weight_key
value_key = argv.value_key
is_norm = not argv.not_norm

# Power spectrum binning parameters
use_FFTPower2D = argv.use_FFTPower2D
kmin = argv.kmin
kmin_str = f"{kmin:.1f}".replace(".", "dot")
kmax = argv.kmax
kmax_str = f"{kmax:.1f}".replace(".", "dot")
dk = argv.dk
Nmu = argv.Nmu
mode = argv.mode

# dk can be None (auto-determined) when using FFTPower2D
dk_str = "_auto" if dk is None else f"{dk:.2f}".replace(".", "dot")

# Generate mode string for filename
if use_FFTPower2D:
    mode_str = ""
elif mode == "1d":
    mode_str = "_1d"
else:
    mode_str = f"_Nmu{Nmu:d}"

# Determine output filenames (auto-generate if not specified)
fftpower_filename = argv.fftpower_filename
if fftpower_filename is None:
    if use_FFTPower2D:
        fftpower_filename = data_dir + f"/fftpower-{data_name}-Nmesh{Nmesh:d}-dk{dk_str}{mode_str}.pkl"
    else:
        fftpower_filename = data_dir + f"/fftpower-{data_name}-Nmesh{Nmesh:d}-k{kmin_str}to{kmax_str}_dk{dk_str}{mode_str}.pkl"

mesh_dir = argv.mesh_dir
if mesh_dir is None:
    mesh_dir = data_dir + f"/mesh-{data_name}-BoxSize{boxsize:.0f}_Nmesh{Nmesh:d}"

# Execution flags
only_run_mesh = argv.only_run_mesh
force = argv.force
force_mesh = argv.force_mesh
verbose = argv.verbose

# Warn about ignored parameters when using FFTPower2D
if use_FFTPower2D and verbose:
    print("WARNING: --use_FFTPower2D is enabled. kmin, kmax, Nmu, and mode are ignored.")
    if dk is not None:
        print(f"  dk={dk:.2f} is provided but will be determined automatically by FFTPower2D.")

# Early exit: if not forcing anything and the final power spectrum already exists,
# skip mesh loading entirely to avoid unnecessary I/O
if not only_run_mesh and not force and not force_mesh and os.path.exists(fftpower_filename):
    if verbose:
        print(f"Power spectrum file {fftpower_filename} already exists. Use -force to re-compute.")
    exit(0)

# ============================================================================
# Mesh creation or loading
# ============================================================================
# Check if mesh already exists and no re-computation is requested
mesh_exists = os.path.exists(mesh_dir + "/complex_field.npy")
if mesh_exists and not force_mesh:
    if only_run_mesh:
        # Only computing mesh but it already exists
        print("Mesh already exists. Skip.")
        exit(0)
    else:
        # Mesh exists, just load it (no need to read particle data)
        if verbose:
            print("Mesh exists. Now reading ...")
        mesh = Mesh.load(mesh_dir, only_complex=True)
        if verbose:
            print("Mesh read done.")
else:
    # Mesh does not exist or forcing re-computation: need to read particle data
    data, use_weight, use_value = read_data(data_filename, weight_key, value_key)
    mesh = Mesh(Nmesh, boxsize)

    # Extract optional weight and value fields from columns
    if use_weight:
        weights = data[:, 3]
    else:
        weights = None
    if use_value:
        values = data[:, 3 + (1 if use_weight else 0)]
    else:
        values = None

    if verbose:
        print("Now running mesh...")
        print(f"Number of particles is {data.shape[0]:d}; Boxsize is {boxsize:.0f}; Nmesh is {Nmesh:d}.")
        print(f"Use resampler CIC; Use weights: {use_weight}; Use values: {use_value}; Normalized: {is_norm}")
        print(f"Use nthreads: {nthreads:d}")

    # Mesh the particle distribution using Cloud-in-Cell (CIC) interpolation
    mesh.to_mesh(data[:, :3], resampler="CIC", weights=weights, values=values,
                 nthreads=nthreads, is_norm=is_norm, c_api=True)
    # Perform FFT and apply compensation
    mesh.r2c(compensated=True, nthreads=nthreads, c_api=True)

    if verbose:
        print(f"Mesh created. Now saving mesh to {mesh_dir}")
    mesh.save(mesh_dir, mode="all")
    if verbose:
        print("Mesh saved.")

# ============================================================================
# Power spectrum calculation
# ============================================================================
if not only_run_mesh:
    # Compute power spectrum from the mesh
    if not os.path.exists(fftpower_filename) or force:
        if use_FFTPower2D:
            fftpower = FFTPower2D(Nmesh, boxsize)
            if verbose:
                print("Now running FFTPower2D...")
                print(f"Use nthreads: {nthreads:d}")
                print(f"dk is determined automatically (kmin, kmax, Nmu are ignored).")
            
            # Compute 2D power spectrum from the meshed density field
            fftpower.cal_ps_2d_from_mesh(mesh, nthreads=nthreads, dk=dk)
        else:
            fftpower = FFTPower(Nmesh, boxsize)
            if verbose:
                print("Now running fftpower...")
                print(f"kmin is {kmin:.1f}; kmax is {kmax:.1f}; dk is {dk:.2f}; Nmu is {Nmu:d}; mode is {mode}")
                print(f"Use nthreads: {nthreads:d}")
            
            # Compute power spectrum from the meshed density field
            power = fftpower.cal_ps_from_mesh(mesh, kmin, kmax, dk, Nmu, 
                                              mode=mode, nthreads=nthreads, 
                                              c_api=True, compensated=True)
        
        # Save power spectrum result
        fftpower.save(fftpower_filename)
        if verbose:
            print(f"fftpower saved to {fftpower_filename}")
    else:
        if verbose:
            print(f"Power spectrum file {fftpower_filename} already exists. Use -force to re-compute.")